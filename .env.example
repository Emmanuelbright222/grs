# ============================================
# REQUIRED — Supabase Configuration
# ============================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-public-key

# ============================================
# REQUIRED — Email Service (Resend)
# Used by Supabase Edge Functions and the
# Vercel serverless API route (api/send-email.js)
# ============================================
RESEND_API_KEY=re_your_resend_api_key_here

# ============================================
# OPTIONAL — Streaming Platform Client IDs
# Add these as you configure each platform
# ============================================
VITE_SPOTIFY_CLIENT_ID=your_spotify_client_id
VITE_APPLE_MUSIC_CLIENT_ID=your_apple_music_client_id
VITE_YOUTUBE_CLIENT_ID=your_youtube_client_id
VITE_AUDIOMACK_CLIENT_ID=your_audiomack_client_id
VITE_BOOMPLAY_CLIENT_ID=your_boomplay_client_id

# ============================================
# OPTIONAL — hCaptcha Bot Protection
# ============================================
VITE_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key

# ============================================
# OPTIONAL — Custom Email Function URL
# Only needed if you host the email function
# outside of Supabase Edge Functions
# ============================================
# VITE_CUSTOM_EMAIL_FUNCTION_URL=https://your-custom-endpoint.com/send-email
